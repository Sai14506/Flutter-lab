import 'package:flutter/material.dart';

void main() {
  runApp(
    const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: StudentDashboard(),
    ),
  );
}

class StudentDashboard extends StatefulWidget {
  const StudentDashboard({super.key});

  @override
  State<StudentDashboard> createState() => _StudentDashboardState();
}

class _StudentDashboardState extends State<StudentDashboard> {
  bool notification = false;
  int counter = 0;

  // Dashboard feature boxes
  Widget featureBox(IconData icon, String text) {
    return Column(
      children: [
        Container(
          height: 65,
          width: 65,
          decoration: BoxDecoration(
            color: Colors.blue.shade100,
            borderRadius: BorderRadius.circular(15),
          ),
          child: Icon(
            icon,
            color: Colors.blue,
            size: 35,
          ),
        ),
        const SizedBox(height: 8),
        Text(
          text,
          style: const TextStyle(
            fontSize: 15,
            fontWeight: FontWeight.w500,
          ),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Student Dashboard"),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        child: Column(
          children: [
            // College background and student details
            Stack(
              clipBehavior: Clip.none,
              children: [
                // Background image
                Image.network(
                  "https://www.facebook.com/srivishnueducationalsociety/mentions/.jpg",
                  width: double.infinity,
                  height: 220,
                  fit: BoxFit.cover,
                  errorBuilder: (context, error, stackTrace) {
                    return Container(
                      width: double.infinity,
                      height: 220,
                      color: Colors.blue,
                      child: const Center(
                        child: Text(
                          "Vishnu Institute of Technology",
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 23,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    );
                  },
                ),

                // Dark overlay
                Positioned.fill(
                  child: Container(
                    color: Colors.black.withOpacity(0.3),
                  ),
                ),

                // College logo / profile image (Using NetworkImage instead of AssetImage)
                const Positioned(
                  left: 20,
                  bottom: -40,
                  child: CircleAvatar(
                    radius: 45,
                    backgroundColor: Colors.white,
                    backgroundImage: NetworkImage(
                      "https://ic4s-conference.eai-conferences.org/2023/about-vishnu-institute-of-technology/index.html.jpg",
                    ),
                  ),
                ),

                // Student name and course
                const Positioned(
                  left: 120,
                  right: 8,
                  bottom: 25,
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        "T Sai Chandu",
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      Text(
                        "Computer Science Student",
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 15,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),

            const SizedBox(height: 60),

            // Dashboard features
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                featureBox(Icons.menu_book, "Books"),
                featureBox(Icons.assignment, "Tasks"),
                featureBox(Icons.school, "Marks"),
                featureBox(Icons.person, "Profile"),
              ],
            ),

            const SizedBox(height: 30),

            // Login and Register buttons
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                ElevatedButton(
                  onPressed: notification
                      ? () {
                          ScaffoldMessenger.of(context).showSnackBar(
                            const SnackBar(
                              content: Text("Login Button Pressed"),
                            ),
                          );
                        }
                      : null,
                  child: const Text("Login"),
                ),
                OutlinedButton(
                  onPressed: notification
                      ? () {
                          ScaffoldMessenger.of(context).showSnackBar(
                            const SnackBar(
                              content: Text("Register Button Pressed"),
                            ),
                          );
                        }
                      : null,
                  child: const Text("Register"),
                ),
              ],
            ),

            const SizedBox(height: 25),

            // Notification switch
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Text(
                  "Notifications",
                  style: TextStyle(fontSize: 20),
                ),
                Switch(
                  value: notification,
                  onChanged: (value) {
                    setState(() {
                      notification = value;
                    });
                  },
                ),
              ],
            ),

            const SizedBox(height: 20),

            // Counter title
            const Text(
              "Counter",
              style: TextStyle(
                fontSize: 30,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 10),

            // Counter value
            Text(
              "$counter",
              style: const TextStyle(
                fontSize: 45,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 20),

            // Increment and decrement buttons
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                ElevatedButton(
                  onPressed: notification
                      ? () {
                          setState(() {
                            counter++;
                          });
                        }
                      : null,
                  child: const Text(
                    "+",
                    style: TextStyle(fontSize: 22),
                  ),
                ),
                ElevatedButton(
                  onPressed: notification
                      ? () {
                          setState(() {
                            counter--;
                          });
                        }
                      : null,
                  child: const Text(
                    "-",
                    style: TextStyle(fontSize: 22),
                  ),
                ),
              ],
            ),

            const SizedBox(height: 30),

            // College website link
            TextButton(
              onPressed: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    content: Text(
                      "Visit vishnu.edu.in for college information",
                    ),
                  ),
                );
              },
              child: const Text(
                "Vishnu Institute of Technology",
                style: TextStyle(fontSize: 16),
              ),
            ),

            const SizedBox(height: 20),
          ],
        ),
      ),
    );
  }
}
